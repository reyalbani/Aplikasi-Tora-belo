import { Head, Link } from '@inertiajs/react';
import { ArrowLeft, CheckCircle2, Info, FileText, User, UploadCloud, File, AlertCircle, Copy } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { FormEvent, useState, useRef } from 'react';
import { store } from '@/routes/ppid';

interface Props {
    layanan: {
        id_layanan: number;
        nama_layanan: string;
        deskripsi: string;
        icon: string;
    };
}

export default function PPIDForm({ layanan }: Props) {
    const [step, setStep] = useState(1);
    const [isSubmitting, setIsSubmitting] = useState(false);
    const [successData, setSuccessData] = useState<{ kode_tiket: string } | null>(null);
    const [copied, setCopied] = useState(false);
    const [serverErrors, setServerErrors] = useState<Record<string, any>>({});
    
    const [data, setData] = useState({
        id_layanan: layanan.id_layanan,
        jenis_pemohon: 'Perorangan',
        nik: '',
        nama: '',
        email: '',
        no_hp: '',
        alamat: '',
        rincian_informasi: '',
        tujuan_penggunaan: '',
        cara_memperoleh: '',
        cara_mendapatkan_salinan: '',
        dokumen_ktp: null as File | null,
        dokumen_legalitas: null as File | null,
        dokumen_surat_kuasa: null as File | null,
        dokumen_identitas_pemberi_kuasa: null as File | null,
    });

    const ktpInputRef = useRef<HTMLInputElement>(null);
    const legalitasInputRef = useRef<HTMLInputElement>(null);
    const suratKuasaInputRef = useRef<HTMLInputElement>(null);
    const identitasPemberiKuasaInputRef = useRef<HTMLInputElement>(null);

    const updateData = (field: keyof typeof data, value: any) => {
        setData(prev => ({ ...prev, [field]: value }));
        if (serverErrors[field]) {
            setServerErrors(prev => {
                const newErrs = { ...prev };
                delete newErrs[field];
                return newErrs;
            });
        }
    };

    const nextStep = () => {
        let isValid = true;
        if (step === 1) {
            if (!data.jenis_pemohon || !data.nik || !data.nama || !data.email || !data.no_hp || !data.alamat) isValid = false;
        } else if (step === 2) {
            if (!data.rincian_informasi || !data.tujuan_penggunaan || !data.cara_memperoleh || !data.cara_mendapatkan_salinan) isValid = false;
        }

        if (isValid) {
            setStep(s => s + 1);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
            alert('Mohon lengkapi semua field wajib (*) sebelum melanjutkan.');
        }
    };

    const prevStep = () => {
        setStep(s => s - 1);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const submit = async (e: FormEvent) => {
        e.preventDefault();
        
        let isValidDoc = true;
        let errMsg = '';
        if (!data.dokumen_ktp) {
            isValidDoc = false; errMsg = 'Identitas/KTP wajib diunggah.';
        }
        if ((data.jenis_pemohon === 'Lembaga/Organisasi Masyarakat' || data.jenis_pemohon === 'Badan Hukum') && !data.dokumen_legalitas) {
            isValidDoc = false; errMsg = 'Dokumen legalitas wajib diunggah.';
        }
        if (data.jenis_pemohon === 'Kuasa Pemohon') {
            if (!data.dokumen_surat_kuasa) { isValidDoc = false; errMsg = 'Surat kuasa wajib diunggah.'; }
            if (!data.dokumen_identitas_pemberi_kuasa) { isValidDoc = false; errMsg = 'Identitas pemberi kuasa wajib diunggah.'; }
        }
        
        if (!isValidDoc) {
            alert(errMsg);
            return;
        }
        
        setIsSubmitting(true);
        setServerErrors({});
        
        const formData = new FormData();
        Object.entries(data).forEach(([key, value]) => {
            if (value !== null) {
                formData.append(key, value as any);
            }
        });
        
        const getXsrfToken = () => {
            const match = document.cookie.match(new RegExp('(^| )XSRF-TOKEN=([^;]+)'));
            if (match) return decodeURIComponent(match[2]);
            return '';
        };

        try {
            const response = await fetch(store.url(), {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-XSRF-TOKEN': getXsrfToken()
                },
                body: formData
            });
            
            const result = await response.json();
            
            if (response.ok && result.success) {
                setSuccessData({ kode_tiket: result.kode_tiket });
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                throw { response: { data: result } };
            }
        } catch (error: any) {
            if (error.response?.data?.errors) {
                // Laravel validation errors
                const formattedErrors: Record<string, string> = {};
                Object.keys(error.response.data.errors).forEach(key => {
                    formattedErrors[key] = error.response.data.errors[key][0];
                });
                setServerErrors(formattedErrors);
            } else if (error.response?.data?.message) {
                setServerErrors({ _global: error.response.data.message });
            } else {
                setServerErrors({ _global: 'Terjadi kesalahan jaringan atau sistem.' });
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } finally {
            setIsSubmitting(false);
        }
    };

    const handleFileChange = (field: keyof typeof data, ref: React.RefObject<HTMLInputElement>) => (e: React.ChangeEvent<HTMLInputElement>) => {
        const file = e.target.files?.[0];
        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                alert('Ukuran file maksimal 5MB.');
                if (ref.current) ref.current.value = '';
                return;
            }
            updateData(field, file);
        }
    };

    const copyToClipboard = () => {
        if (successData?.kode_tiket) {
            navigator.clipboard.writeText(successData.kode_tiket);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        }
    };

    // Shared input class string for consistent styling and fixing white text issue
    const inputClasses = (error: string | undefined) => 
        `w-full rounded-xl border ${error ? 'border-red-500' : 'border-neutral-200 focus:border-kpu-primary'} px-4 py-3 text-sm focus:outline-none focus:ring-4 focus:ring-kpu-primary/10 transition-all bg-white text-neutral-900 placeholder:text-neutral-400`;

    return (
        <div className="flex min-h-screen flex-col bg-[#f8fafc]">
            <Head title={`${layanan.nama_layanan} - SIPADU`} />

            {/* STANDALONE TOP BAR */}
            <header className="bg-white border-b border-neutral-200/60 sticky top-0 z-50 shadow-sm">
                <div className="container mx-auto px-4 h-16 flex items-center justify-between max-w-5xl">
                    <div className="flex items-center gap-3">
                        <img src="/images/logo-kpu.png" alt="Logo KPU" className="h-9 w-auto" />
                        <span className="font-extrabold text-neutral-900 text-base sm:text-lg tracking-tight">SIPADU KPU KOTA PALU</span>
                        <span className="text-neutral-300 mx-1 sm:mx-2 hidden sm:inline-block">|</span>
                        <span className="text-neutral-600 font-bold text-sm hidden sm:inline-block">Layanan PPID</span>
                    </div>
                    <Link href="/" className="inline-flex items-center text-[13px] sm:text-sm font-bold text-neutral-600 hover:text-kpu-primary transition-colors bg-neutral-100 hover:bg-red-50 px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl">
                        <ArrowLeft className="w-4 h-4 mr-1 sm:mr-1.5" />
                        <span className="hidden sm:inline-block">Kembali ke Portal Publik</span>
                        <span className="inline-block sm:hidden">Kembali</span>
                    </Link>
                </div>
            </header>

            <main className="flex-1 container mx-auto px-4 py-8 sm:py-10 max-w-4xl">
                {successData ? (
                    // SUCCESS STATE UI (Rendered immediately after API response)
                    <div className="bg-white rounded-[24px] p-8 md:p-14 shadow-sm border border-neutral-200/60 text-center relative overflow-hidden mt-4 animate-fade-in">
                        <div className="absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-green-50/80 to-transparent pointer-events-none"></div>
                        <div className="mx-auto w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mb-6 shadow-sm">
                            <CheckCircle2 className="w-10 h-10" strokeWidth={2.5} />
                        </div>
                        <h2 className="text-2xl md:text-3xl font-bold text-neutral-800 mb-3 tracking-tight">Permohonan PPID Berhasil Dikirim!</h2>
                        <p className="text-neutral-600 mb-8 max-w-lg mx-auto leading-relaxed">
                            Permohonan Anda telah berhasil diterima dan sedang menunggu proses verifikasi.
                        </p>
                        
                        <div className="bg-neutral-50 border border-neutral-200 rounded-[16px] p-8 max-w-md mx-auto mb-10 shadow-sm relative">
                            <p className="text-sm text-neutral-500 mb-2 font-semibold">KODE TRACKER ANDA</p>
                            <div className="flex items-center justify-center gap-4 mb-4">
                                <p className="text-4xl sm:text-5xl font-bold text-kpu-primary tracking-widest">{successData.kode_tiket}</p>
                            </div>
                            <Button 
                                type="button" 
                                onClick={copyToClipboard} 
                                variant="outline" 
                                className="rounded-xl px-6 h-10 text-neutral-700 hover:bg-neutral-100 font-semibold text-sm transition-all"
                            >
                                {copied ? <CheckCircle2 className="w-4 h-4 mr-2 text-green-600" /> : <Copy className="w-4 h-4 mr-2" />}
                                {copied ? 'Kode Berhasil Disalin' : 'Salin Kode Tracker'}
                            </Button>
                            <p className="text-sm text-neutral-500 mt-6 font-medium px-4">Simpan kode ini untuk memantau status permohonan Anda.</p>
                        </div>
                        
                        <div className="flex flex-col sm:flex-row items-center justify-center gap-4">
                            <Button asChild className="rounded-xl px-8 w-full sm:w-auto h-12 bg-kpu-primary hover:bg-kpu-primary-dark text-white font-bold shadow-md shadow-kpu-primary/20">
                                <Link href={`/cek-status?tiket=${successData.kode_tiket}`}>Cek Status Permohonan →</Link>
                            </Button>
                            <Button asChild variant="outline" className="rounded-xl px-8 w-full sm:w-auto h-12 text-neutral-700 font-semibold border-neutral-200">
                                <Link href="/">Kembali ke Portal Publik</Link>
                            </Button>
                        </div>
                    </div>
                ) : (
                    // FORM UI
                    <div className="space-y-6 mt-2">
                        {/* Header Info */}
                        <div className="bg-white rounded-[24px] p-6 sm:p-8 shadow-sm border border-neutral-200/60">
                            <div className="flex items-start sm:items-center gap-4 sm:gap-5">
                                <div className="w-12 h-12 sm:w-14 sm:h-14 bg-red-50 text-kpu-primary rounded-[16px] flex items-center justify-center shrink-0 border border-red-100">
                                    <Info className="w-6 h-6 sm:w-7 sm:h-7" />
                                </div>
                                <div>
                                    <h1 className="text-xl sm:text-2xl font-bold text-neutral-800 mb-1 leading-tight tracking-tight">
                                        Formulir {layanan.nama_layanan}
                                    </h1>
                                    <p className="text-[13px] sm:text-sm text-neutral-500 leading-relaxed">
                                        Layanan Permohonan Informasi Publik (PPID) KPU Kota Palu berdasarkan UU No. 14 Tahun 2008 tentang Keterbukaan Informasi Publik.
                                    </p>
                                </div>
                            </div>
                        </div>

                        {Object.keys(serverErrors).length > 0 && (
                            <div className="bg-red-50 border border-red-200 text-red-700 px-6 py-4 rounded-[16px] flex flex-col gap-2">
                                <div className="flex items-start gap-3">
                                    <AlertCircle className="w-5 h-5 shrink-0 mt-0.5" />
                                    <p className="text-sm font-bold">Pengajuan belum dapat dikirim. Periksa data berikut:</p>
                                </div>
                                <ul className="list-disc pl-9 text-sm space-y-1">
                                    {Object.entries(serverErrors).map(([key, err]) => {
                                        // Jangan tampilkan _global dua kali jika sudah ditampilkan di atas, 
                                        // tapi karena kita mengganti blok error utama, kita tampilkan semua di sini.
                                        const label = key === '_global' ? 'System Error' : key.replace(/_/g, ' ');
                                        return (
                                            <li key={key}>
                                                <span className="font-semibold capitalize">{label}:</span> {err as string}
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        )}

                        <div className="bg-white rounded-[24px] shadow-sm border border-neutral-200/60 overflow-hidden">
                            {/* Stepper Header */}
                            <div className="flex border-b border-neutral-100 bg-neutral-50/50">
                                {[
                                    { num: 1, label: 'Data Pemohon', icon: User },
                                    { num: 2, label: 'Detail Permohonan', icon: FileText },
                                    { num: 3, label: 'Dokumen', icon: UploadCloud }
                                ].map((item) => {
                                    const isActive = step === item.num;
                                    const isPassed = step > item.num;
                                    return (
                                        <div key={item.num} className={`flex-1 p-3 sm:p-5 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 transition-colors ${isActive ? 'bg-white border-b-2 border-kpu-primary text-kpu-primary' : isPassed ? 'text-neutral-600' : 'text-neutral-400'}`}>
                                            <div className={`w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-[11px] sm:text-sm font-bold shrink-0 ${isActive ? 'bg-kpu-primary text-white' : isPassed ? 'bg-neutral-200 text-neutral-700' : 'bg-neutral-100 text-neutral-400'}`}>
                                                {isPassed ? <CheckCircle2 className="w-4 h-4 sm:w-5 sm:h-5" /> : item.num}
                                            </div>
                                            <span className={`text-[10px] sm:text-sm font-semibold text-center sm:text-left ${isActive ? 'text-kpu-primary' : ''}`}>{item.label}</span>
                                        </div>
                                    );
                                })}
                            </div>

                            <form onSubmit={submit} className="p-5 sm:p-8 md:p-10">
                                {/* Step 1: Data Pemohon */}
                                <div className={step === 1 ? 'block' : 'hidden'}>
                                    <h3 className="text-lg font-bold text-neutral-800 mb-6">Identitas Pemohon</h3>
                                    <div className="space-y-5">
                                        <div>
                                            <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Jenis Pemohon *</label>
                                            <select
                                                value={data.jenis_pemohon}
                                                onChange={e => updateData('jenis_pemohon', e.target.value)}
                                                className={inputClasses(serverErrors.jenis_pemohon)}
                                            >
                                                <option value="Perorangan">Perorangan</option>
                                                <option value="Lembaga/Organisasi Masyarakat">Lembaga/Organisasi Masyarakat</option>
                                                <option value="Badan Hukum">Badan Hukum</option>
                                                <option value="Kuasa Pemohon">Kuasa Pemohon</option>
                                            </select>
                                            {serverErrors.jenis_pemohon && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.jenis_pemohon}</p>}
                                        </div>
                                        
                                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">NIK (Nomor Induk Kependudukan) *</label>
                                                <input
                                                    type="text"
                                                    value={data.nik}
                                                    onChange={e => updateData('nik', e.target.value)}
                                                    className={inputClasses(serverErrors.nik)}
                                                    placeholder="16 digit NIK"
                                                />
                                                {serverErrors.nik && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.nik}</p>}
                                            </div>
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Nama Lengkap *</label>
                                                <input
                                                    type="text"
                                                    value={data.nama}
                                                    onChange={e => updateData('nama', e.target.value)}
                                                    className={inputClasses(serverErrors.nama)}
                                                    placeholder="Sesuai KTP"
                                                />
                                                {serverErrors.nama && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.nama}</p>}
                                            </div>
                                        </div>

                                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Email Aktif *</label>
                                                <input
                                                    type="email"
                                                    value={data.email}
                                                    onChange={e => updateData('email', e.target.value)}
                                                    className={inputClasses(serverErrors.email)}
                                                    placeholder="email@contoh.com"
                                                />
                                                {serverErrors.email && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.email}</p>}
                                            </div>
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Nomor Telepon / WhatsApp *</label>
                                                <input
                                                    type="text"
                                                    value={data.no_hp}
                                                    onChange={e => updateData('no_hp', e.target.value)}
                                                    className={inputClasses(serverErrors.no_hp)}
                                                    placeholder="08xxxxxxxxxx"
                                                />
                                                {serverErrors.no_hp && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.no_hp}</p>}
                                            </div>
                                        </div>

                                        <div>
                                            <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Alamat Lengkap *</label>
                                            <textarea
                                                value={data.alamat}
                                                onChange={e => updateData('alamat', e.target.value)}
                                                rows={3}
                                                className={`${inputClasses(serverErrors.alamat)} resize-none`}
                                                placeholder="Jalan, RT/RW, Kelurahan, Kecamatan, Kota/Kabupaten"
                                            ></textarea>
                                            {serverErrors.alamat && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.alamat}</p>}
                                        </div>
                                    </div>
                                    <div className="mt-8 flex justify-end">
                                        <Button type="button" onClick={nextStep} className="rounded-xl px-8 h-12 w-full sm:w-auto bg-kpu-primary hover:bg-red-700 text-white font-bold shadow-sm">Lanjut ke Detail <ArrowLeft className="w-4 h-4 ml-2 rotate-180" /></Button>
                                    </div>
                                </div>

                                {/* Step 2: Detail Permohonan */}
                                <div className={step === 2 ? 'block' : 'hidden'}>
                                    <h3 className="text-lg font-bold text-neutral-800 mb-6">Detail Informasi yang Dibutuhkan</h3>
                                    <div className="space-y-6">
                                        <div>
                                            <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Rincian Informasi yang Dibutuhkan *</label>
                                            <textarea
                                                value={data.rincian_informasi}
                                                onChange={e => updateData('rincian_informasi', e.target.value)}
                                                rows={4}
                                                className={`${inputClasses(serverErrors.rincian_informasi)} resize-none`}
                                                placeholder="Jelaskan secara rinci informasi apa yang Anda butuhkan..."
                                            ></textarea>
                                            {serverErrors.rincian_informasi && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.rincian_informasi}</p>}
                                        </div>

                                        <div>
                                            <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Tujuan Penggunaan Informasi *</label>
                                            <input
                                                type="text"
                                                value={data.tujuan_penggunaan}
                                                onChange={e => updateData('tujuan_penggunaan', e.target.value)}
                                                className={inputClasses(serverErrors.tujuan_penggunaan)}
                                                placeholder="Contoh: Penelitian skripsi, keperluan pribadi, dll."
                                            />
                                            {serverErrors.tujuan_penggunaan && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.tujuan_penggunaan}</p>}
                                        </div>

                                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Cara Memperoleh Informasi *</label>
                                                <select
                                                    value={data.cara_memperoleh}
                                                    onChange={e => updateData('cara_memperoleh', e.target.value)}
                                                    className={inputClasses(serverErrors.cara_memperoleh)}
                                                >
                                                    <option value="" disabled>Pilih cara...</option>
                                                    <option value="Melihat/Membaca/Mendengarkan/Mencatat">Melihat / Membaca / Mendengarkan / Mencatat</option>
                                                    <option value="Mendapatkan Salinan Dokumen (Hardcopy/Softcopy)">Mendapatkan Salinan Dokumen (Hardcopy/Softcopy)</option>
                                                </select>
                                                {serverErrors.cara_memperoleh && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.cara_memperoleh}</p>}
                                            </div>
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-1.5">Cara Mendapatkan Salinan Informasi *</label>
                                                <select
                                                    value={data.cara_mendapatkan_salinan}
                                                    onChange={e => updateData('cara_mendapatkan_salinan', e.target.value)}
                                                    className={inputClasses(serverErrors.cara_mendapatkan_salinan)}
                                                >
                                                    <option value="" disabled>Pilih cara...</option>
                                                    <option value="Mengambil Langsung">Mengambil Langsung</option>
                                                    <option value="Dikirim via Email">Dikirim via Email</option>
                                                    <option value="Dikirim via Pos/Kurir">Dikirim via Pos/Kurir</option>
                                                </select>
                                                {serverErrors.cara_mendapatkan_salinan && <p className="mt-1.5 text-xs text-red-500 font-medium">{serverErrors.cara_mendapatkan_salinan}</p>}
                                            </div>
                                        </div>
                                    </div>
                                    <div className="mt-8 flex flex-col-reverse sm:flex-row justify-between gap-3">
                                        <Button type="button" variant="outline" onClick={prevStep} className="rounded-xl px-8 h-12 w-full sm:w-auto border border-kpu-primary text-kpu-primary bg-white hover:bg-red-50 hover:text-kpu-primary font-bold shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-[1px]"><ArrowLeft className="w-4 h-4 mr-2" /> Kembali</Button>
                                        <Button type="button" onClick={nextStep} className="rounded-xl px-8 h-12 w-full sm:w-auto bg-kpu-primary hover:bg-red-700 text-white font-bold shadow-sm">Lanjut ke Dokumen <ArrowLeft className="w-4 h-4 ml-2 rotate-180" /></Button>
                                    </div>
                                </div>

                                {/* Step 3: Upload Dokumen */}
                                <div className={step === 3 ? 'block' : 'hidden'}>
                                    <h3 className="text-lg font-bold text-neutral-800 mb-2">Unggah Dokumen Pendukung</h3>
                                    <p className="text-sm text-neutral-500 mb-6">Sesuai peraturan, pemohon informasi diwajibkan menyertakan identitas diri yang sah.</p>
                                    
                                    <div className="space-y-6">
                                        {/* KTP / Identitas */}
                                        <div>
                                            <label className="block text-[13px] font-semibold text-neutral-700 mb-3">
                                                {data.jenis_pemohon === 'Perorangan' ? 'Scan/Foto KTP Asli *' : 'KTP/Identitas Penanggung Jawab *'}
                                            </label>
                                            
                                            <div 
                                                className={`border-2 border-dashed rounded-2xl p-6 sm:p-8 text-center transition-all ${
                                                    data.dokumen_ktp 
                                                        ? 'border-green-400 bg-green-50/50' 
                                                        : serverErrors.dokumen_ktp 
                                                            ? 'border-red-400 bg-red-50/50' 
                                                            : 'border-neutral-300 hover:border-kpu-primary hover:bg-neutral-50/80 cursor-pointer bg-white'
                                                }`}
                                                onClick={() => !data.dokumen_ktp && ktpInputRef.current?.click()}
                                            >
                                                <input 
                                                    type="file" 
                                                    ref={ktpInputRef} 
                                                    className="hidden" 
                                                    accept=".jpg,.jpeg,.png,.pdf"
                                                    onChange={handleFileChange('dokumen_ktp', ktpInputRef)}
                                                />
                                                
                                                {data.dokumen_ktp ? (
                                                    <div className="flex flex-col items-center">
                                                        <div className="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mb-3">
                                                            <File className="w-6 h-6" />
                                                        </div>
                                                        <p className="text-sm font-bold text-neutral-900">{data.dokumen_ktp.name}</p>
                                                        <p className="text-xs text-neutral-600 mt-1">{(data.dokumen_ktp.size / 1024 / 1024).toFixed(2)} MB</p>
                                                        <Button 
                                                            type="button" 
                                                            variant="outline" 
                                                            size="sm" 
                                                            className="mt-4 rounded-lg h-8 text-xs bg-white text-neutral-800 border-neutral-300 hover:bg-neutral-100 z-10 relative"
                                                            onClick={(e) => {
                                                                e.stopPropagation();
                                                                updateData('dokumen_ktp', null);
                                                                if (ktpInputRef.current) ktpInputRef.current.value = '';
                                                            }}
                                                        >
                                                            Ganti File
                                                        </Button>
                                                    </div>
                                                ) : (
                                                    <div className="flex flex-col items-center">
                                                        <div className="w-14 h-14 bg-neutral-100 text-neutral-500 rounded-full flex items-center justify-center mb-4">
                                                            <UploadCloud className="w-7 h-7" />
                                                        </div>
                                                        <p className="text-sm font-semibold text-neutral-800 mb-1">Klik untuk memilih file identitas</p>
                                                        <p className="text-xs text-neutral-500">Format: JPG, PNG, PDF (Maks. 5MB)</p>
                                                    </div>
                                                )}
                                            </div>
                                            {serverErrors.dokumen_ktp && <p className="mt-2 text-xs text-red-500 font-medium">{serverErrors.dokumen_ktp}</p>}
                                        </div>

                                        {/* Dokumen Legalitas (For Lembaga / Badan Hukum) */}
                                        {(data.jenis_pemohon === 'Lembaga/Organisasi Masyarakat' || data.jenis_pemohon === 'Badan Hukum') && (
                                            <div>
                                                <label className="block text-[13px] font-semibold text-neutral-700 mb-3">Dokumen Legalitas/Akta Notaris/SK *</label>
                                                <div 
                                                    className={`border-2 border-dashed rounded-2xl p-6 sm:p-8 text-center transition-all ${
                                                        data.dokumen_legalitas ? 'border-green-400 bg-green-50/50' : serverErrors.dokumen_legalitas ? 'border-red-400 bg-red-50/50' : 'border-neutral-300 hover:border-kpu-primary hover:bg-neutral-50/80 cursor-pointer bg-white'
                                                    }`}
                                                    onClick={() => !data.dokumen_legalitas && legalitasInputRef.current?.click()}
                                                >
                                                    <input type="file" ref={legalitasInputRef} className="hidden" accept=".jpg,.jpeg,.png,.pdf" onChange={handleFileChange('dokumen_legalitas', legalitasInputRef)} />
                                                    {data.dokumen_legalitas ? (
                                                        <div className="flex flex-col items-center">
                                                            <div className="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mb-3"><File className="w-6 h-6" /></div>
                                                            <p className="text-sm font-bold text-neutral-900">{data.dokumen_legalitas.name}</p>
                                                            <p className="text-xs text-neutral-600 mt-1">{(data.dokumen_legalitas.size / 1024 / 1024).toFixed(2)} MB</p>
                                                            <Button type="button" variant="outline" size="sm" className="mt-4 rounded-lg h-8 text-xs bg-white text-neutral-800 border-neutral-300 hover:bg-neutral-100 z-10 relative" onClick={(e) => { e.stopPropagation(); updateData('dokumen_legalitas', null); if (legalitasInputRef.current) legalitasInputRef.current.value = ''; }}>Ganti File</Button>
                                                        </div>
                                                    ) : (
                                                        <div className="flex flex-col items-center">
                                                            <div className="w-14 h-14 bg-neutral-100 text-neutral-500 rounded-full flex items-center justify-center mb-4"><UploadCloud className="w-7 h-7" /></div>
                                                            <p className="text-sm font-semibold text-neutral-800 mb-1">Klik untuk memilih dokumen legalitas</p>
                                                            <p className="text-xs text-neutral-500">Format: JPG, PNG, PDF (Maks. 5MB)</p>
                                                        </div>
                                                    )}
                                                </div>
                                                {serverErrors.dokumen_legalitas && <p className="mt-2 text-xs text-red-500 font-medium">{serverErrors.dokumen_legalitas}</p>}
                                            </div>
                                        )}

                                        {/* Kuasa Pemohon Docs */}
                                        {data.jenis_pemohon === 'Kuasa Pemohon' && (
                                            <>
                                                <div>
                                                    <label className="block text-[13px] font-semibold text-neutral-700 mb-3">Surat Kuasa Bermaterai *</label>
                                                    <div className={`border-2 border-dashed rounded-2xl p-6 sm:p-8 text-center transition-all ${data.dokumen_surat_kuasa ? 'border-green-400 bg-green-50/50' : serverErrors.dokumen_surat_kuasa ? 'border-red-400 bg-red-50/50' : 'border-neutral-300 hover:border-kpu-primary hover:bg-neutral-50/80 cursor-pointer bg-white'}`} onClick={() => !data.dokumen_surat_kuasa && suratKuasaInputRef.current?.click()}>
                                                        <input type="file" ref={suratKuasaInputRef} className="hidden" accept=".jpg,.jpeg,.png,.pdf" onChange={handleFileChange('dokumen_surat_kuasa', suratKuasaInputRef)} />
                                                        {data.dokumen_surat_kuasa ? (
                                                            <div className="flex flex-col items-center">
                                                                <div className="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mb-3"><File className="w-6 h-6" /></div>
                                                                <p className="text-sm font-bold text-neutral-900">{data.dokumen_surat_kuasa.name}</p>
                                                                <Button type="button" variant="outline" size="sm" className="mt-4 rounded-lg h-8 text-xs bg-white text-neutral-800 border-neutral-300 hover:bg-neutral-100 z-10 relative" onClick={(e) => { e.stopPropagation(); updateData('dokumen_surat_kuasa', null); if (suratKuasaInputRef.current) suratKuasaInputRef.current.value = ''; }}>Ganti File</Button>
                                                            </div>
                                                        ) : (
                                                            <div className="flex flex-col items-center">
                                                                <div className="w-14 h-14 bg-neutral-100 text-neutral-500 rounded-full flex items-center justify-center mb-4"><UploadCloud className="w-7 h-7" /></div>
                                                                <p className="text-sm font-semibold text-neutral-800 mb-1">Klik untuk memilih surat kuasa</p>
                                                            </div>
                                                        )}
                                                    </div>
                                                    {serverErrors.dokumen_surat_kuasa && <p className="mt-2 text-xs text-red-500 font-medium">{serverErrors.dokumen_surat_kuasa}</p>}
                                                </div>

                                                <div>
                                                    <label className="block text-[13px] font-semibold text-neutral-700 mb-3">Identitas Pemberi Kuasa *</label>
                                                    <div className={`border-2 border-dashed rounded-2xl p-6 sm:p-8 text-center transition-all ${data.dokumen_identitas_pemberi_kuasa ? 'border-green-400 bg-green-50/50' : serverErrors.dokumen_identitas_pemberi_kuasa ? 'border-red-400 bg-red-50/50' : 'border-neutral-300 hover:border-kpu-primary hover:bg-neutral-50/80 cursor-pointer bg-white'}`} onClick={() => !data.dokumen_identitas_pemberi_kuasa && identitasPemberiKuasaInputRef.current?.click()}>
                                                        <input type="file" ref={identitasPemberiKuasaInputRef} className="hidden" accept=".jpg,.jpeg,.png,.pdf" onChange={handleFileChange('dokumen_identitas_pemberi_kuasa', identitasPemberiKuasaInputRef)} />
                                                        {data.dokumen_identitas_pemberi_kuasa ? (
                                                            <div className="flex flex-col items-center">
                                                                <div className="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mb-3"><File className="w-6 h-6" /></div>
                                                                <p className="text-sm font-bold text-neutral-900">{data.dokumen_identitas_pemberi_kuasa.name}</p>
                                                                <Button type="button" variant="outline" size="sm" className="mt-4 rounded-lg h-8 text-xs bg-white text-neutral-800 border-neutral-300 hover:bg-neutral-100 z-10 relative" onClick={(e) => { e.stopPropagation(); updateData('dokumen_identitas_pemberi_kuasa', null); if (identitasPemberiKuasaInputRef.current) identitasPemberiKuasaInputRef.current.value = ''; }}>Ganti File</Button>
                                                            </div>
                                                        ) : (
                                                            <div className="flex flex-col items-center">
                                                                <div className="w-14 h-14 bg-neutral-100 text-neutral-500 rounded-full flex items-center justify-center mb-4"><UploadCloud className="w-7 h-7" /></div>
                                                                <p className="text-sm font-semibold text-neutral-800 mb-1">Klik untuk memilih KTP pemberi kuasa</p>
                                                            </div>
                                                        )}
                                                    </div>
                                                    {serverErrors.dokumen_identitas_pemberi_kuasa && <p className="mt-2 text-xs text-red-500 font-medium">{serverErrors.dokumen_identitas_pemberi_kuasa}</p>}
                                                </div>
                                            </>
                                        )}

                                        <div className="bg-blue-50/50 border border-blue-200 p-4 rounded-[16px] flex items-start gap-3 mt-6">
                                            <Info className="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                                            <div>
                                                <p className="text-[13px] text-blue-900 leading-relaxed font-medium">
                                                    Dengan mengirimkan permohonan ini, saya menyatakan bahwa data yang saya berikan adalah benar dan informasi yang diperoleh akan digunakan sesuai dengan ketentuan peraturan perundang-undangan yang berlaku.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div className="mt-8 flex flex-col-reverse sm:flex-row justify-between gap-3">
                                        <Button type="button" disabled={isSubmitting} variant="outline" onClick={prevStep} className="rounded-xl px-8 h-12 w-full sm:w-auto border border-kpu-primary text-kpu-primary bg-white hover:bg-red-50 hover:text-kpu-primary font-bold shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-[1px]"><ArrowLeft className="w-4 h-4 mr-2" /> Kembali</Button>
                                        <Button 
                                            type="submit" 
                                            disabled={isSubmitting}
                                            className="rounded-xl px-8 h-12 bg-kpu-primary hover:bg-red-700 shadow-sm min-w-[200px] w-full sm:w-auto text-white font-bold"
                                        >
                                            {isSubmitting ? 'Mengirim Permohonan...' : 'Kirim Permohonan PPID'}
                                        </Button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                )}
                
                {/* Minimal Standalone Footer Text for PPID Page */}
                <div className="mt-10 text-center">
                    <p className="text-xs text-neutral-400 font-medium">
                        &copy; {new Date().getFullYear()} KPU Kota Palu. Hak Cipta Dilindungi.
                    </p>
                </div>
            </main>
        </div>
    );
}
